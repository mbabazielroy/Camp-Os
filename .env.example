# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI API key, used server-side only for categorizing emails and drafting replies
OPENAI_API_KEY=
# Optional: override the model (defaults to gpt-4o-mini)
# OPENAI_MODEL=

# Optional: Google integrations (Google Cloud Console -> OAuth 2.0 credentials).
# One client covers both; connect each from Settings independently.
#   Gmail    - add <your-app-url>/api/gmail/callback as a redirect URI.
#              Scopes: gmail.readonly + gmail.compose (drafts only, never sends).
#   Calendar - add <your-app-url>/api/calendar/callback as a redirect URI.
#              Scope: calendar.events (writes confirmed bookings, reads the agenda).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
