# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI API key, used server-side only for categorizing emails and drafting replies
OPENAI_API_KEY=
# Optional: override the model (defaults to gpt-4o-mini)
# OPENAI_MODEL=

# Optional: Gmail integration (Google Cloud Console -> OAuth 2.0 credentials).
# Add <your-app-url>/api/gmail/callback as an authorized redirect URI.
# Scopes used: gmail.readonly + gmail.compose (drafts only - the app can never send).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing (Stripe). Leave all of these blank to run without billing: the
# billing page then says "Billing not configured" and nothing is gated.
# Secret key (Developers -> API keys). Server-side only.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <your-app-url>/api/stripe/webhook,
# subscribed to checkout.session.completed, customer.subscription.updated and
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# The CA$79/month recurring price (price_...). Change the price in Stripe by
# creating a new price and updating this id; no code change needed.
STRIPE_PRICE_ID=
# Supabase service-role key (Project Settings -> API). Server-only: used by the
# Stripe webhook to update a camp's billing status. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
